{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tardigradsoftware-design/havuz-2/schemas/evaluation.schema.json",
  "title": "Evaluation / Benchmark Record",
  "description": "A benchmark suite or an internal evaluation task. Internal tasks use the WITHOUT_KB / WITH_KB comparison protocol.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "kind",
    "measures",
    "status",
    "updated"
  ],
  "properties": {
    "id": {
      "$ref": "common.defs.json#/$defs/id"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "external-benchmark",
        "internal-task",
        "skill-test",
        "regression-suite",
        "red-team",
        "ablation"
      ]
    },
    "domain": {
      "type": "string",
      "enum": [
        "coding",
        "frontend",
        "agents",
        "research",
        "reasoning",
        "web",
        "tool-use",
        "instruction-following",
        "hallucination",
        "safety",
        "multimodal",
        "knowledge-base"
      ]
    },
    "purpose": {
      "type": [
        "string",
        "null"
      ]
    },
    "task": {
      "type": [
        "string",
        "null"
      ],
      "description": "For internal-task: the exact prompt given to the agent"
    },
    "measures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "scale": {
            "type": [
              "string",
              "null"
            ]
          },
          "better": {
            "type": "string",
            "enum": [
              "higher",
              "lower"
            ]
          },
          "threshold": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "protocol": {
      "type": [
        "string",
        "null"
      ],
      "description": "How to run it so results are comparable"
    },
    "pass_criteria": {
      "type": [
        "string",
        "null"
      ]
    },
    "contamination_risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ]
    },
    "reproducibility": {
      "type": "string",
      "enum": [
        "reproducible",
        "partially-reproducible",
        "not-reproducible",
        "unknown"
      ]
    },
    "dataset": {
      "type": [
        "string",
        "null"
      ]
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    },
    "repository": {
      "type": [
        "string",
        "null"
      ]
    },
    "maintainer": {
      "type": [
        "string",
        "null"
      ]
    },
    "license": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "experimental",
        "deprecated",
        "draft",
        "archived"
      ]
    },
    "maintenance_status": {
      "$ref": "common.defs.json#/$defs/maintenanceStatus"
    },
    "results": {
      "type": "array",
      "description": "Recorded runs. Every number must carry its run date and config.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_at",
          "subject"
        ],
        "properties": {
          "run_at": {
            "$ref": "common.defs.json#/$defs/date"
          },
          "subject": {
            "type": "string",
            "description": "Model/agent/configuration under test"
          },
          "variant": {
            "type": "string",
            "enum": [
              "without-kb",
              "with-kb",
              "baseline",
              "treatment"
            ]
          },
          "scores": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "number",
                "string"
              ]
            }
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "$ref": "common.defs.json#/$defs/tags"
    },
    "confidence": {
      "$ref": "common.defs.json#/$defs/confidence"
    },
    "claim_type": {
      "$ref": "common.defs.json#/$defs/claimType"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "common.defs.json#/$defs/sourceRef"
      }
    },
    "provenance": {
      "$ref": "common.defs.json#/$defs/provenance"
    },
    "updated": {
      "$ref": "common.defs.json#/$defs/date"
    },
    "verified_at": {
      "$ref": "common.defs.json#/$defs/date"
    },
    "evidence_level": {
      "$ref": "common.defs.json#/$defs/evidenceLevel"
    },
    "expires_at": {
      "$ref": "common.defs.json#/$defs/date"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "heading",
          "anchor"
        ],
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "anchor": {
            "type": "string",
            "pattern": "^#[a-z0-9-]+$"
          },
          "purpose": {
            "type": "string"
          }
        }
      },
      "description": "Declared section map, enabling isolated retrieval: a section fetched alone must still be self-contained."
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "related_skills": {
      "type": "array",
      "items": {
        "$ref": "common.defs.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "related_repositories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
