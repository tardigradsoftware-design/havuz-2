{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tardigradsoftware-design/havuz-2/schemas/dataset.schema.json",
  "title": "Dataset Record",
  "properties": {
    "id": { "$ref": "common.defs.json#/$defs/id" },
    "name": { "type": "string" },
    "category": { "type": "string", "enum": ["public", "reasoning", "coding", "agents", "benchmarks", "instruction", "preference", "safety"] },
    "url": { "type": "string", "pattern": "^https?://" },
    "huggingface": { "type": ["string", "null"] },
    "repository": { "type": ["string", "null"] },
    "paper": { "type": ["string", "null"] },
    "maintainer": { "type": ["string", "null"] },
    "license": { "type": ["string", "null"] },
    "size": { "type": ["string", "null"] },
    "modality": { "type": "array", "items": { "type": "string" } },
    "purpose": { "type": "string" },
    "use_for": { "type": "array", "items": { "type": "string" } },
    "do_not_use_for": { "type": "array", "items": { "type": "string" } },
    "contains_pii": { "type": "string", "enum": ["no", "possible", "yes", "unknown"] },
    "contains_private_reasoning": { "type": "boolean", "description": "Must be false. This repository never ingests private chain-of-thought or leaked model internals." },
    "contamination_risk": { "type": "string", "enum": ["low", "medium", "high", "unknown"] },
    "redistributable": { "type": "boolean" },
    "status": { "type": "string", "enum": ["active", "experimental", "deprecated", "draft"] },
    "confidence": { "$ref": "common.defs.json#/$defs/confidence" },
    "tags": { "$ref": "common.defs.json#/$defs/tags" },
    "sources": { "type": "array", "items": { "$ref": "common.defs.json#/$defs/sourceRef" } },
    "verified_at": { "$ref": "common.defs.json#/$defs/date" },
    "expires_at": { "$ref": "common.defs.json#/$defs/date" }
  },
  "additionalProperties": false,
  "required": ["id", "name", "category", "url", "purpose", "license", "contains_private_reasoning", "verified_at"]
}
