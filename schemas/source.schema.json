{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tardigradsoftware-design/havuz-2/schemas/source.schema.json",
  "title": "Research Source",
  "description": "Any non-repository source of knowledge: paper, official docs, blog, benchmark, dataset, specification, discussion.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "type", "url", "source_quality", "confidence", "summary", "verified_at"],
  "properties": {
    "id": { "$ref": "common.defs.json#/$defs/id" },
    "title": { "type": "string", "minLength": 3 },
    "type": { "$ref": "common.defs.json#/$defs/sourceType" },
    "url": { "type": "string", "pattern": "^https?://" },
    "doi": { "type": ["string", "null"] },
    "arxiv": { "type": ["string", "null"], "pattern": "^\\d{4}\\.\\d{4,5}(v\\d+)?$" },
    "author_count": { "type": ["integer", "null"], "minimum": 0 },
    "primary_category": { "type": ["string", "null"], "description": "arXiv primary subject class" },
    "comment": { "type": ["string", "null"], "description": "arXiv author comment (often states venue / acceptance)" },
    "journal_ref": { "type": ["string", "null"] },
    "title_match_ratio": { "type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "Similarity between queried title and title returned by the source API" },
    "query_title": { "type": ["string", "null"] },
    "repository": { "type": ["string", "null"], "description": "owner/name of the reference implementation, if any" },
    "dataset": { "type": ["string", "null"] },
    "benchmark": { "type": ["string", "null"] },
    "authors": { "type": "array", "items": { "type": "string" } },
    "author": { "type": ["string", "null"] },
    "organization": { "type": ["string", "null"] },
    "institution": { "type": ["string", "null"] },
    "published": { "$ref": "common.defs.json#/$defs/date" },
    "updated": { "oneOf": [{ "$ref": "common.defs.json#/$defs/date" }, { "type": "null" }] },
    "license": { "type": ["string", "null"] },
    "category": { "type": "string" },
    "tags": { "$ref": "common.defs.json#/$defs/tags" },
    "summary": { "type": "string", "minLength": 40 },
    "key_findings": { "type": "array", "items": { "type": "string" } },
    "key_contribution": { "type": ["string", "null"] },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "reproducibility": { "type": "string", "enum": ["reproducible", "partially-reproducible", "not-reproducible", "unknown"] },
    "source_quality": { "type": "integer", "minimum": 1, "maximum": 10 },
    "authority": { "type": "integer", "minimum": 0, "maximum": 10 },
    "evidence": { "type": "integer", "minimum": 0, "maximum": 10 },
    "maintenance": { "type": "string", "enum": ["maintained", "static", "stale", "archived", "unknown"] },
    "adoption": { "type": "string", "enum": ["very-high", "high", "moderate", "low", "minimal", "unknown"] },
    "relevance": { "type": "string", "enum": ["primary", "supporting", "contextual", "historical"] },
    "confidence": { "$ref": "common.defs.json#/$defs/confidence" },
    "claim_type": { "$ref": "common.defs.json#/$defs/claimType" },
    "evidence_level": { "$ref": "common.defs.json#/$defs/evidenceLevel" },
    "corroborated_by": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Other source ids or URLs that independently support the same claim."
    },
    "conflicts_with": { "type": "array", "items": { "type": "string" } },
    "conflict_note": { "type": ["string", "null"] },
    "related_sources": { "type": "array", "items": { "type": "string" } },
    "used_by": { "type": "array", "items": { "type": "string" }, "description": "Repo-relative paths of skills/patterns citing this source" },
    "scoring": { "$ref": "common.defs.json#/$defs/scoring" },
    "provenance": { "$ref": "common.defs.json#/$defs/provenance" },
    "verified_at": { "$ref": "common.defs.json#/$defs/date" },
    "expires_at": { "$ref": "common.defs.json#/$defs/date" },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url_reachable": { "type": "boolean" },
        "http_status": { "type": ["integer", "null"] },
        "content_matches_description": { "type": ["boolean", "null"] },
        "checked_by": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}
