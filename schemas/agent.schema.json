{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tardigradsoftware-design/havuz-2/schemas/agent.schema.json",
  "title": "Agent Role",
  "description": "A specialised agent persona with a bounded mandate, a fixed output contract, and explicit refusal conditions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "role",
    "mandate",
    "inputs",
    "outputs",
    "status",
    "updated"
  ],
  "properties": {
    "name": {
      "$ref": "common.defs.json#/$defs/id"
    },
    "version": {
      "$ref": "common.defs.json#/$defs/semver"
    },
    "role": {
      "type": "string"
    },
    "mandate": {
      "type": "string",
      "minLength": 30
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "research",
        "engineering",
        "review",
        "quality",
        "security",
        "design",
        "curation",
        "verification",
        "meta",
        "planning",
        "data"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "experimental",
        "deprecated",
        "draft",
        "archived"
      ]
    },
    "updated": {
      "$ref": "common.defs.json#/$defs/date"
    },
    "tags": {
      "$ref": "common.defs.json#/$defs/tags"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 3
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "description"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "description": "Field name in the input/output contract. snake_case is allowed because these name data fields, not knowledge-base identifiers."
              },
              "type": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string",
                "minLength": 10
              }
            }
          }
        ]
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 3
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "description"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "description": "Field name in the input/output contract. snake_case is allowed because these name data fields, not knowledge-base identifiers."
              },
              "type": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string",
                "minLength": 10
              }
            }
          }
        ]
      }
    },
    "output_contract": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 10
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "required_fields"
          ],
          "properties": {
            "format": {
              "type": "string"
            },
            "required_fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "must_not_contain": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "on_uncertainty": {
              "type": "string"
            },
            "schema_ref": {
              "type": "string"
            }
          }
        }
      ],
      "description": "Exact required shape of the final answer, and what must never appear in it."
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "common.defs.json#/$defs/id"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mcp": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "purpose",
              "capability_tier"
            ],
            "properties": {
              "id": {
                "$ref": "common.defs.json#/$defs/id"
              },
              "purpose": {
                "type": "string",
                "minLength": 10
              },
              "capability_tier": {
                "type": "string"
              },
              "registry_ref": {
                "type": "string"
              }
            }
          }
        ]
      },
      "description": "MCP servers this agent may use. Each entry states the narrowest capability tier that satisfies its purpose (see skills/mcp-integration)."
    },
    "knowledge": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "delegates_to": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "common.defs.json#/$defs/id"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "agent",
              "for"
            ],
            "properties": {
              "agent": {
                "$ref": "common.defs.json#/$defs/id"
              },
              "for": {
                "type": "string",
                "minLength": 5
              }
            }
          }
        ]
      }
    },
    "escalates_to_human_when": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "refuses_when": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failure_modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 10
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "description",
              "mitigation"
            ],
            "properties": {
              "name": {
                "$ref": "common.defs.json#/$defs/id"
              },
              "description": {
                "type": "string",
                "minLength": 10
              },
              "detection": {
                "type": "string"
              },
              "mitigation": {
                "type": "string",
                "minLength": 10
              }
            }
          }
        ]
      },
      "description": "Named failure modes with how each is detected and mitigated. A failure mode without a detection method cannot be managed."
    },
    "quality_bar": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "$ref": "common.defs.json#/$defs/confidence"
    },
    "scoring": {
      "$ref": "common.defs.json#/$defs/scoring"
    },
    "provenance": {
      "$ref": "common.defs.json#/$defs/provenance"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "common.defs.json#/$defs/sourceRef"
      }
    },
    "claim_type": {
      "$ref": "common.defs.json#/$defs/claimType"
    },
    "evidence_level": {
      "$ref": "common.defs.json#/$defs/evidenceLevel"
    },
    "verified_at": {
      "$ref": "common.defs.json#/$defs/date"
    },
    "expires_at": {
      "$ref": "common.defs.json#/$defs/date"
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "estimated_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "related_skills": {
      "type": "array",
      "items": {
        "$ref": "common.defs.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "related_repositories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "tests": {
      "type": [
        "integer",
        "array"
      ],
      "items": {
        "type": "string"
      }
    }
  }
}
