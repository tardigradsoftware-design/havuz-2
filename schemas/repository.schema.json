{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tardigradsoftware-design/havuz-2/schemas/repository.schema.json",
  "title": "GitHub Repository Record",
  "description": "One verified GitHub repository. Generated fields come from the GitHub API; curated fields come from scripts/update/seeds.json and human review.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "owner", "slug", "url", "category", "stars", "license", "status", "confidence", "verified_at"],
  "properties": {
    "requested_slug": { "type": "string" },
    "renamed_to": { "type": ["string", "null"] },
    "aliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "description": "Other slugs that resolve to this repository (renames, duplicate seeds)." },
    "name": { "type": "string" },
    "owner": { "type": "string" },
    "owner_type": { "type": "string", "enum": ["Organization", "User"] },
    "slug": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
    "url": { "type": "string", "pattern": "^https://github\\.com/" },
    "description": { "type": ["string", "null"] },
    "homepage": { "type": ["string", "null"] },
    "category": {
      "type": "string",
      "enum": ["agent-frameworks", "agent-skills", "mcp-servers", "browser-automation", "frontend",
               "backend", "databases", "ai", "evaluation", "reasoning-research", "developer-tools",
               "instructions-standards", "misc"]
    },
    "curated_tier": {
      "type": "string",
      "enum": ["seed", "core", "reference", "candidate", "status-check", "skip"],
      "description": "Human intent: why this repo is tracked at all."
    },
    "curated_tags": { "$ref": "common.defs.json#/$defs/tags" },
    "language": { "type": ["string", "null"] },
    "license": { "type": "string" },
    "license_nonstandard": { "type": "boolean" },
    "license_risk": {
      "type": "string",
      "enum": ["none", "custom-license-review-before-vendoring", "no-license-do-not-redistribute"]
    },
    "stars": { "type": "integer", "minimum": 0 },
    "forks": { "type": "integer", "minimum": 0 },
    "open_issues": { "type": "integer", "minimum": 0 },
    "watchers": { "type": ["integer", "null"], "minimum": 0 },
    "contributors": { "type": ["integer", "null"], "minimum": 0 },
    "default_branch": { "type": "string" },
    "created_at": { "type": ["string", "null"] },
    "pushed_at": { "type": ["string", "null"] },
    "last_commit": { "type": ["string", "null"] },
    "days_since_push": { "type": ["integer", "null"], "minimum": 0 },
    "latest_release": { "type": ["string", "null"] },
    "latest_release_published_at": { "type": ["string", "null"] },
    "archived": { "type": "boolean" },
    "disabled": { "type": "boolean" },
    "is_fork": { "type": "boolean" },
    "has_issues": { "type": "boolean" },
    "has_discussions": { "type": "boolean" },
    "has_wiki": { "type": "boolean" },
    "topics": { "type": "array", "items": { "type": "string" } },
    "official": { "type": "boolean" },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "has_readme": { "type": "boolean" },
        "readme_bytes": { "type": "integer", "minimum": 0 },
        "has_docs": { "type": "boolean" },
        "has_tests": { "type": "boolean" },
        "has_ci": { "type": "boolean" },
        "has_examples": { "type": "boolean" },
        "has_security_md": { "type": "boolean" },
        "has_changelog": { "type": "boolean" },
        "has_contributing": { "type": "boolean" },
        "root_entries": { "type": "integer", "minimum": 0 }
      }
    },
    "status": { "$ref": "common.defs.json#/$defs/maintenanceStatus" },
    "maintenance_status": { "$ref": "common.defs.json#/$defs/maintenanceStatus" },
    "production_ready": { "type": "boolean" },
    "documentation_quality": { "type": "string", "enum": ["excellent", "good", "adequate", "poor"] },
    "community_adoption": { "type": "string", "enum": ["very-high", "high", "moderate", "low", "minimal"] },
    "security_status": { "type": "string", "enum": ["policy-published", "no-policy", "archived-no-patches", "unknown"] },
    "repo_kind": { "type": "string", "enum": ["software", "research-artifact", "paper-code", "benchmark", "dataset", "model-release", "catalog", "docs", "issue-tracker"] },
    "static_artifact": { "type": "boolean" },
    "relevance": { "type": "string", "enum": ["primary", "supporting", "contextual", "historical"] },
    "confidence": { "$ref": "common.defs.json#/$defs/confidence" },
    "evidence_level": { "$ref": "common.defs.json#/$defs/evidenceLevel" },
    "source_type": { "type": "string", "const": "github-repository" },
    "recommended_for": { "type": "array", "items": { "type": "string" } },
    "not_recommended_for": { "type": "array", "items": { "type": "string" } },
    "related_projects": { "type": "array", "items": { "type": "string" } },
    "strengths": { "type": "array", "items": { "type": "string" } },
    "weaknesses": { "type": "array", "items": { "type": "string" } },
    "quality": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 10 }
    },
    "quality_score": { "type": "number", "minimum": 0, "maximum": 10 },
    "trust_score": { "type": "number", "minimum": 0, "maximum": 10 },
    "tier": { "$ref": "common.defs.json#/$defs/tier" },
    "maturity": { "type": "string" },
    "notes": { "type": ["string", "null"] },
    "provenance": { "type": "string" },
    "claim_type": { "$ref": "common.defs.json#/$defs/claimType" },
    "curation_claim_type": { "$ref": "common.defs.json#/$defs/claimType" },
    "curated_at": { "$ref": "common.defs.json#/$defs/date" },
    "strengths": { "type": "array", "items": { "type": "string" } },
    "weaknesses": { "type": "array", "items": { "type": "string" } },
    "verified_at": { "$ref": "common.defs.json#/$defs/date" },
    "stars_checked_at": { "$ref": "common.defs.json#/$defs/date" },
    "expires_at": { "$ref": "common.defs.json#/$defs/date" },
    "fetch_ok": { "type": "boolean" },
    "error": { "type": "string" },
    "http_status": { "type": "integer" }
  }
}
